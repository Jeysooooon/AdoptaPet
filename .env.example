# Root .env.example for AdoptaPet
# Copy this file to .env in each microservice folder and fill values.

# Database connection (per-service use different DB names)
# Example: mysql+pymysql://user:password@localhost:3306/db_name
DATABASE_URL=your_database_connection_string_here

# Flask secret key (session, CSRF, etc.)
SECRET_KEY=replace_with_a_random_secret_key

# Shared JWT secret used to sign tokens across services
JWT_SECRET_KEY=replace_with_a_shared_jwt_secret_for_all_services

# Optional: override service port
PORT=48910